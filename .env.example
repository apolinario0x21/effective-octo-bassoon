# Copie para .env e ajuste conforme necessário: cp .env.example .env
# O docker-compose lê este arquivo automaticamente.

# --- API ---------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info            # debug | info | warn | error
APP_ENV=development       # development | production

# --- Autenticação (JWT + refresh token) --------------------------------------
# JWT_SECRET assina os tokens e NUNCA deve ser hardcoded/commitado.
# Em produção (APP_ENV=production) é obrigatório: a API não sobe sem ele.
# Em desenvolvimento, se vazio, um segredo efêmero aleatório é gerado no boot.
JWT_SECRET=
JWT_ACCESS_TTL=15m        # validade do access token
JWT_REFRESH_TTL=168h      # validade do refresh token (7 dias)
REFRESH_CLEANUP_INTERVAL=1h  # limpeza dos refresh tokens expirados/revogados (0 desabilita)

# Admin inicial (opcional): se ambos preenchidos e o usuário não existir, é
# criado no boot. Use para ter um admin no primeiro deploy.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Banco de dados (PostgreSQL) ---------------------------------------------
DB_DRIVER=postgres        # postgres | sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=students
DB_PASSWORD=students
DB_NAME=students
DB_SSLMODE=disable
# Alternativa: informe a DSN completa e ignore os campos acima.
# DB_DSN=host=localhost port=5432 user=students password=students dbname=students sslmode=disable

# --- Cache (Redis) -----------------------------------------------------------
# Deixe REDIS_ADDR vazio para desabilitar o cache (acesso direto ao banco).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=5m

# --- Grafana -----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
